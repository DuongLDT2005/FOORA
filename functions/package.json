{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "seed": "npm run build && node lib/scripts/seed_firestore.js",
    "seed:emulator": "npm run build && node lib/scripts/seed_firestore.js",
    "seed:prod": "npm run build && node lib/scripts/seed_firestore.js --prod",
    "upload:food-images": "npm run build && node lib/scripts/upload_food_images.js",
    "seed:mock": "npm run build && node lib/scripts/seed_mock_users.js",
    "analytics:demo": "npm run build && node lib/scripts/synthetic_analytics.js",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test test/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-foora-rules \"node --test test/rules/*.test.js\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@payos/node": "^2.0.5",
    "dotenv": "^18.0.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.4.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.0"
  },
  "private": true
}
