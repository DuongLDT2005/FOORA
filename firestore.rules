rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function validNotificationSettings(s) {
      return s is map
        && s.keys().hasOnly(['pushEnabled', 'expiryAlertDays', 'reminderHour',
             'shoppingReminderEnabled', 'shoppingReminderWeekday', 'updatedAt'])
        && s.pushEnabled is bool
        && s.expiryAlertDays is list && s.expiryAlertDays.size() <= 3
        && s.expiryAlertDays.toSet().difference([1, 3, 7].toSet()).size() == 0
        && s.reminderHour is int && s.reminderHour >= 0 && s.reminderHour <= 23
        && s.shoppingReminderEnabled is bool
        && s.shoppingReminderWeekday is int
        && s.shoppingReminderWeekday >= 1 && s.shoppingReminderWeekday <= 7
        && s.updatedAt == request.time;
    }

    function optionalString(data, key, maxSize) {
      return !(key in data) || data[key] == null
        || (data[key] is string && data[key].size() <= maxSize);
    }

    // Users collection & Subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      // The onUserCreated trigger (Admin SDK) owns the system fields. The owner
      // may only pre-create the profile part if the trigger has not run yet.
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['fullName', 'updatedAt']);
      // Owner may update profile fields only. `email` may be synced solely to
      // the verified address carried by the Firebase Auth token.
      allow update: if isOwner(userId)
        && changedKeys().hasOnly(['fullName', 'avatarUrl', 'email', 'updatedAt',
             'notificationSettings'])
        && (!changedKeys().hasAny(['email'])
          || (request.auth.token.email_verified == true
            && request.resource.data.email == request.auth.token.email))
        && (!changedKeys().hasAny(['notificationSettings'])
          || validNotificationSettings(request.resource.data.notificationSettings));
      allow delete: if false; // Users can only be deleted via Firebase Auth account deletion trigger

      // Devices Subcollection: only device owner can register/update/delete their device
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications are created by Cloud Functions. Owners may only mark read.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create, delete: if false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
      }

      // Subscriptions Subcollection
      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(userId);
        allow write: if false; // Managed by Cloud Functions
      }

      // Receipts Subcollection
      match /receipts/{receiptId} {
        allow read, write: if isOwner(userId);

        match /items/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }

      // AI Usage Subcollection
      match /ai_usage/{docId} {
        allow read: if isOwner(userId);
        allow write: if false; // Managed by Cloud Functions
      }

      match /ai_chats/{messageId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /ai_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /ai_requests/{requestId} {
        allow read, write: if false;
      }

      match /ai_usage_days/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Payments Subcollection
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if false; // Managed by Cloud Functions
      }
    }

    // Households collection & Subcollections
    match /households/{householdId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      // Households are created by Cloud Functions; members, owner and the
      // activeItemCount counter are backend-managed.
      allow create, delete: if false;
      allow update: if isAuthenticated()
        && request.auth.uid == resource.data.ownerId
        && changedKeys().hasOnly(['name', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;

      match /inventory_items/{itemId} {
        allow read: if isHouseholdMember(householdId);
        // New items go through addInventoryItem / batchAddInventoryItems so
        // the membership foodLimit is enforced server-side.
        allow create, delete: if false;
        allow update: if isHouseholdMember(householdId)
          && changedKeys().hasOnly([
            'foodId', 'name', 'normalizedName', 'categoryId', 'quantity',
            'unit', 'initialQuantity', 'remainingPercentage',
            'storageLocationId', 'purchaseDate', 'expirationDate', 'photoUrl',
            'status', 'statusChangedAt', 'updatedAt'
          ])
          && request.resource.data.status in ['active', 'consumed', 'discarded']
          // Re-activating a consumed/discarded item would bypass foodLimit.
          && !(resource.data.status != 'active' && request.resource.data.status == 'active')
          && request.resource.data.quantity is number
          && request.resource.data.quantity >= 0
          && request.resource.data.initialQuantity is number
          && request.resource.data.initialQuantity > 0
          && request.resource.data.quantity <= request.resource.data.initialQuantity
          && (request.resource.data.status != 'active' || request.resource.data.quantity > 0)
          && (request.resource.data.status == 'active' || request.resource.data.quantity == 0)
          && request.resource.data.remainingPercentage is number
          && request.resource.data.remainingPercentage >= 0
          && request.resource.data.remainingPercentage <= 100
          && request.resource.data.remainingPercentage - 0.5 <=
            request.resource.data.quantity * 100 / request.resource.data.initialQuantity
          && request.resource.data.quantity * 100 / request.resource.data.initialQuantity <
            request.resource.data.remainingPercentage + 0.5
          // statusChangedAt must equal server time when written (prevents spoofing).
          && (!changedKeys().hasAny(['statusChangedAt'])
              || request.resource.data.statusChangedAt == request.time)
          // Changing status to consumed/discarded requires statusChangedAt to be set.
          && (resource.data.status == request.resource.data.status
              || request.resource.data.statusChangedAt == request.time);
      }

      // Shopping lists are shared by all household members. Lists are deleted
      // through the deleteShoppingList callable (recursive delete).
      match /shopping_lists/{listId} {
        function validListFields(data) {
          return data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && optionalString(data, 'note', 200);
        }

        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId)
          && request.resource.data.keys().hasOnly(['name', 'note', 'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && validListFields(request.resource.data);
        allow update: if isHouseholdMember(householdId)
          && changedKeys().hasOnly(['name', 'note', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && validListFields(request.resource.data);
        allow delete: if false;

        // Items: clients add, edit, tick and delete. Only the
        // importShoppingItemsToInventory callable may set the inventory fields.
        match /items/{itemId} {
          function validItemFields(data) {
            return data.name is string && data.name.size() > 0 && data.name.size() <= 100
              && data.normalizedName is string && data.normalizedName.size() <= 100
              && data.quantity is number && data.quantity > 0 && data.quantity <= 10000
              && data.unit is string && data.unit.size() > 0 && data.unit.size() <= 20
              && data.source in ['manual', 'voice', 'suggestion', 'ai_recipe']
              && optionalString(data, 'note', 200)
              && optionalString(data, 'foodId', 100)
              && optionalString(data, 'categoryId', 100)
              && data.isPurchased is bool
              && (data.isPurchased
                ? data.purchasedBy is string
                : (data.purchasedBy == null && data.purchasedAt == null));
          }

          allow read: if isHouseholdMember(householdId);
          allow create: if isHouseholdMember(householdId)
            && exists(/databases/$(database)/documents/households/$(householdId)/shopping_lists/$(listId))
            && request.resource.data.keys().hasOnly([
                 'name', 'normalizedName', 'foodId', 'categoryId', 'quantity', 'unit',
                 'note', 'source', 'isPurchased', 'purchasedBy', 'purchasedAt',
                 'isAddedToInventory', 'inventoryItemId', 'addedToInventoryAt',
                 'addedBy', 'createdAt', 'updatedAt'])
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.isPurchased == false
            && request.resource.data.isAddedToInventory == false
            && request.resource.data.inventoryItemId == null
            && request.resource.data.addedToInventoryAt == null
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && validItemFields(request.resource.data);
          allow update: if isHouseholdMember(householdId)
            && resource.data.isAddedToInventory == false
            && changedKeys().hasOnly([
                 'name', 'normalizedName', 'foodId', 'categoryId', 'quantity', 'unit',
                 'note', 'isPurchased', 'purchasedBy', 'purchasedAt', 'updatedAt'])
            && request.resource.data.updatedAt == request.time
            && (!changedKeys().hasAny(['isPurchased'])
              || (request.resource.data.isPurchased
                ? (request.resource.data.purchasedBy == request.auth.uid
                  && request.resource.data.purchasedAt == request.time)
                : true))
            && validItemFields(request.resource.data);
          allow delete: if isHouseholdMember(householdId);
        }
      }
    }

    // Master Data collections (Read-only for authenticated users)
    match /memberships/{membershipId} {
      allow read: if isAuthenticated();
      allow write: if false; // Admin managed
    }

    match /foods/{foodId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /food_categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /storage_locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /shelf_life_rules/{ruleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }


    // Server-only payment lookup and idempotency collections.
    match /payment_order_locks/{lockId} {
      allow read, write: if false;
    }

    match /payment_references/{referenceNumber} {
      allow read, write: if false;
    }

    match /payment_provider_transactions/{transactionId} {
      allow read, write: if false;
    }

    // Household Invitations: Managed exclusively by backend Cloud Functions
    match /household_invitations/{invitationId} {
      allow read, write: if false;
    }

    // Wrong invite-code counters (anti-enumeration): backend only
    match /invite_attempts/{userId} {
      allow read, write: if false;
    }

    // Nearby-store cache is only read and maintained by Cloud Functions.
    match /place_cache/{cellId} {
      allow read, write: if false;
    }

    // Bug Reports collection
    match /bug_reports/{reportId} {
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
